{
  "framework": "vite",
  "rewrites": [
    {
      "source": "/((?!api/|assets/|brand/|.*\\..*).*)",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/((?!api/|assets/|brand/|.*\\..*).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/api/version",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/follow-up-reminders",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/booking-reminders",
      "schedule": "*/5 * * * *"
    }
  ]
}
